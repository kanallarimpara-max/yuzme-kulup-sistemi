# Firebase web uygulaması ayarları (ücretsiz Spark planı)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Firebase Cloud Messaging web anahtarı (kapalı uygulama bildirimi)
VITE_FIREBASE_VAPID_KEY=
# Android'de yalnız google-services.json eklendiyse 1 yapın
VITE_ANDROID_PUSH=

# Cloudinary anahtarları buraya yazılmaz: Worker secret olarak tutulur
# (CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET)

# Cloudflare Worker adresi (AI ve bildirim)
VITE_WORKER_URL=
