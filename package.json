{
  "name": "yuzme-kulup-sistemi",
  "private": true,
  "version": "0.1.0",
  "description": "Yüzme kulübü yönetim sistemi",
  "author": "Kulvar360",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "vitest run",
    "e2e": "firebase emulators:exec --only auth,firestore --project demo-yuzme-e2e \"node scripts/e2e-sunucu.mjs\"",
    "test:worker": "node worker/worker-testi.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-yuzme-kural \"node scripts/kural-testi.mjs\"",
    "devam": "node scripts/devam.mjs",
    "windows": "npm run build && electron-builder --win portable --publish never",
    "android:sync": "npm run build && cap sync android"
  },
  "build": {
    "appId": "com.yuzmekulup.sistem",
    "productName": "Kulvar360",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/push-notifications": "^8.1.3",
    "dejavu-fonts-ttf": "^2.37.3",
    "firebase": "^13.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.77.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "recharts": "^3.11.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "firebase-tools": "^15.37.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
